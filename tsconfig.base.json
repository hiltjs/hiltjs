{
  "compilerOptions": {
    "target": "ES2022",
    // DOM is here for the WHATWG globals the kernel genuinely uses —
    // AbortController / AbortSignal / DOMException / timers — NOT because any
    // package touches the document. Nothing under packages/ may reference
    // `window` or `document`; the build is platform-neutral.
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true
  }
}
